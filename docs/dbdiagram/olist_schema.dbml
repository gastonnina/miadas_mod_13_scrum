Table olist_customers {
  customer_id char(32) [pk]
  customer_unique_id char(32) [not null, note: 'ID real del cliente; puede aparecer en multiples customer_id']
  customer_zip_code_prefix int [not null]
  customer_city varchar(80) [not null]
  customer_state char(2) [not null]

  Indexes {
    customer_unique_id
    customer_zip_code_prefix
    (customer_state, customer_city)
  }
}

Table olist_sellers {
  seller_id char(32) [pk]
  seller_zip_code_prefix int [not null]
  seller_city varchar(80) [not null]
  seller_state char(2) [not null]

  Indexes {
    seller_zip_code_prefix
    (seller_state, seller_city)
  }
}

Table olist_geolocation {
  geolocation_id bigint [pk, increment]
  geolocation_zip_code_prefix int [not null, note: 'Prefijo no unico; puede tener multiples filas por ciudad/coordenada']
  geolocation_lat decimal(10,7) [not null]
  geolocation_lng decimal(10,7) [not null]
  geolocation_city varchar(80) [not null]
  geolocation_state char(2) [not null]

  Indexes {
    geolocation_zip_code_prefix
    (geolocation_state, geolocation_city)
  }
}

Table product_category_name_translation {
  product_category_name varchar(80) [pk]
  product_category_name_english varchar(80) [not null]
}

Table olist_products {
  product_id char(32) [pk]
  product_category_name varchar(80) [note: 'Categoria en portugues; traducible via product_category_name_translation']
  product_name_lenght int
  product_description_lenght int
  product_photos_qty int
  product_weight_g int
  product_length_cm int
  product_height_cm int
  product_width_cm int

  Indexes {
    product_category_name
  }
}

Table olist_orders {
  order_id char(32) [pk]
  customer_id char(32) [not null, unique]
  order_status varchar(20) [not null, note: 'Estado de la orden: delivered, shipped, canceled, invoiced, processing, etc.']
  order_purchase_timestamp datetime
  order_approved_at datetime
  order_delivered_carrier_date datetime
  order_delivered_customer_date datetime
  order_estimated_delivery_date datetime

  Indexes {
    order_status
    order_purchase_timestamp
  }
}

Table olist_order_items {
  order_id char(32) [not null]
  order_item_id int [not null]
  product_id char(32) [not null]
  seller_id char(32) [not null]
  shipping_limit_date datetime
  price decimal(12,2) [not null]
  freight_value decimal(12,2) [not null]

  Indexes {
    (order_id, order_item_id) [pk]
    product_id
    seller_id
    shipping_limit_date
  }
}

Table olist_order_payments {
  order_id char(32) [not null]
  payment_sequential int [not null]
  payment_type varchar(20) [not null, note: 'Tipo de pago: credit_card, boleto, voucher, debit_card, not_defined']
  payment_installments int [not null]
  payment_value decimal(12,2) [not null]

  Indexes {
    (order_id, payment_sequential) [pk]
    payment_type
  }
}

Table olist_order_reviews {
  review_row_id bigint [pk, increment]
  review_id char(32) [not null, note: 'No siempre unico en el origen; se usa review_row_id como PK tecnica']
  order_id char(32) [not null]
  review_score tinyint [not null, note: 'Escala de satisfaccion de 1 (peor) a 5 (mejor)']
  review_comment_title varchar(255)
  review_comment_message text
  review_creation_date datetime
  review_answer_timestamp datetime

  Indexes {
    review_id
    order_id
    review_score
  }
}

Ref: olist_orders.customer_id > olist_customers.customer_id
Ref: olist_order_items.order_id > olist_orders.order_id
Ref: olist_order_items.product_id > olist_products.product_id
Ref: olist_order_items.seller_id > olist_sellers.seller_id
Ref: olist_order_payments.order_id > olist_orders.order_id
Ref: olist_order_reviews.order_id > olist_orders.order_id
Ref: olist_products.product_category_name > product_category_name_translation.product_category_name

// Relacion logica: customer/seller_zip_code_prefix con geolocation_zip_code_prefix (no FK estricta por duplicados).
